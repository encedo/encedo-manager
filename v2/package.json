{
  "name": "encedo-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Encedo HEM Manager: static ES modules on hem-sdk-js, no build step",
  "scripts": {
    "dev": "node dev/serve.mjs",
    "test": "node --test dev/session.test.mjs dev/qr.test.mjs",
    "smoke": "node dev/smoke.mjs",
    "build": "node build.mjs",
    "smoke:dist": "MANAGER_PATH=/v2/dist/ node dev/smoke.mjs"
  }
}
